# Required for AI features
# Required for Neon PostgreSQL database
# Example: postgresql://neondb_owner:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: same as DATABASE_URL if you prefer this name
NEON_DATABASE_URL=

# Bootstrap account for the first super administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
