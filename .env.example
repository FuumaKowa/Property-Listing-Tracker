# Required for AI features
# Required for Neon PostgreSQL database
# Configure the connection string privately in the runtime environment.
DATABASE_URL=
# Optional: same as DATABASE_URL if you prefer this name
NEON_DATABASE_URL=

# Direct connection for reviewed migrations only (runtime keeps using DATABASE_URL).
DATABASE_URL_UNPOOLED=

# Express server secret. On Cloudflare Pages configure the same name as a Secret.
# Never prefix this with VITE_ or include its value in frontend code.
N8N_INGEST_API_KEY=

# Bootstrap account for the first super administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
